<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_watchlist_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/background_dark"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_watchlist_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自選股觀察"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_watchlist_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快取"
            android:textColor="#A0A0A0"
            android:textSize="10sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_watchlist_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#202020"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/widget_watchlist_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="尚無自選股票"
        android:textColor="#707070"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_watchlist_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="更新時間: --"
        android:textColor="#707070"
        android:textSize="9sp" />
</LinearLayout>
