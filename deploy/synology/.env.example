# TW Market Ledger - Synology DS220+ Environment Configuration
# Copy this file to .env and adjust sensitive values before running deploy.sh

# Application Environment
APP_NAME=TW Market Ledger API
APP_ENV=production
LOG_LEVEL=INFO
BACKEND_IMAGE=ghcr.io/wendell78064/tw_stock_android_spec-backend:latest
REALTIME_PROVIDER=
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_SIMULATION=true

# Security & Secrets (MUST generate strong secrets for production)
# Example generation: openssl rand -base64 32
AUTH_SECRET=replace-with-a-very-strong-auth-secret-min-32-chars
ADMIN_API_KEY=replace-with-a-strong-admin-api-key

# Database (PostgreSQL 16)
POSTGRES_DB=twstock
POSTGRES_USER=twstock
POSTGRES_PASSWORD=replace-with-a-secure-postgres-password
DATABASE_URL=postgresql+asyncpg://twstock:replace-with-a-secure-postgres-password@postgres:5432/twstock

# Redis 7
REDIS_URL=redis://redis:6379/0

# Sync and Pagination
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SYNC_PAGE_LIMIT=100

# Base Data Path on Synology
TWML_DATA_ROOT=/volume1/docker/tw-market-ledger
